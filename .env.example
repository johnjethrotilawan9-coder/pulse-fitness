# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Show the "Create account" option on the login screen.
# Set to true only while creating your own account, then set back to false
# and disable sign-ups in Supabase (Authentication → Providers → Email).
VITE_ALLOW_SIGNUP=false
